{
  "compileOnSave": false,
  "angularCompilerOptions": {
    "strictTemplates": false
  },
"compilerOptions": {
    "baseUrl": "",
    "declaration": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "lib": [
      "es2022",
      "dom"
    ],
"module": "esnext",
    "moduleResolution": "bundler",
    "outDir": "./dist/out-tsc",
    "removeComments": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "target": "es2022",
    "typeRoots": [
      "node_modules/@types"
    ]
  },
  "exclude": [
    "node_modules"
  ],
  "include": [
    "i18n",
    "interfaces",
    "src/main.ts"
  ]
}
